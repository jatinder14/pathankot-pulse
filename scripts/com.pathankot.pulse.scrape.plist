<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Install (keeps Pulse scraping even if UI server is off):
    cp scripts/com.pathankot.pulse.scrape.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.pathankot.pulse.scrape.plist

  Unload:
    launchctl unload ~/Library/LaunchAgents/com.pathankot.pulse.scrape.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pathankot.pulse.scrape</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/flexiple_jr/Desktop/talent/gem-tender-agent/scripts/daily_hub_scrape.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/pathankot_pulse_scrape.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/pathankot_pulse_scrape.err</string>
  <key>WorkingDirectory</key>
  <string>/Users/flexiple_jr/Desktop/talent/gem-tender-agent</string>
</dict>
</plist>
