# Copy to .env and fill in. NEVER commit .env or paste passwords into chat.

# Optional LLM (OpenAI-compatible). Without this, heuristic analysis still works.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional GeM seller login — used ONLY after explicit approval for assisted submit.
# Leave empty for scout/analyse/draft-only mode (recommended).
GEM_USERNAME=
GEM_PASSWORD=

# Autonomy: draft_only | approve_then_assist
AUTONOMY_MODE=draft_only
